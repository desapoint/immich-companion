# Safe companion defaults. Copy values into your deployment secret/config
# system; do not commit populated .env files.
COMPANION_ENV=development
COMPANION_VERSION=0.1.0
IMMICH_URL=http://localhost:2283
# Browser-facing Immich URL used only to build optional "Open in Immich" links.
IMMICH_PUBLIC_URL=http://localhost:2283
IMMICH_API_KEY=replace-with-a-dedicated-immich-api-key
IMMICH_TIMEOUT_SECONDS=5
IMMICH_RETRY_ATTEMPTS=3
IMMICH_RETRY_BACKOFF_SECONDS=0.15
COMPANION_DATABASE_URL=postgresql://companion:replace-me@localhost:5432/immich_companion
SYNC_BATCH_SIZE=250
SYNC_OVERLAP_SECONDS=300
SYNC_LEASE_SECONDS=60
DATABASE_TIMEOUT_SECONDS=5
ALLOW_DESTRUCTIVE_ACTIONS=false
ACTION_MAX_TARGETS=5000
ACTION_PLAN_TTL_SECONDS=900

# Local test helper
COMPANION_TEST_BIND=0.0.0.0
COMPANION_TEST_PORT=8090
IMMICH_TEST_BIND=0.0.0.0
IMMICH_TEST_PORT=22830

# Frontend HMR helper (proxies /api to COMPANION_TEST_PORT)
COMPANION_FRONTEND_BIND=0.0.0.0
COMPANION_FRONTEND_PORT=5173

# Production Compose overlay
IMMICH_COMPANION_VERSION=latest
IMMICH_COMPANION_PORT=8090
COMPANION_IMMICH_API_KEY=replace-with-a-dedicated-immich-api-key
IMMICH_COMPANION_DB_PASSWORD=replace-with-a-dedicated-database-password
# URL used by browser links, for example your normal Tailscale or LAN Immich URL.
IMMICH_COMPANION_PUBLIC_IMMICH_URL=http://localhost:2283
